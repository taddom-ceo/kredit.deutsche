# Vorlage für die Umgebungsvariablen. Nur Namen, keine Werte.
# Zum Arbeiten eine Kopie als .env.local anlegen — die bleibt außerhalb des
# Repositories — und dieselben Werte in den Projekteinstellungen bei Vercel
# eintragen.

# Passwort für die gesamte Seite. Ohne diesen Wert kommt niemand durch,
# auch nicht auf die Startseite.
SITE_PASSWORD=

# CRM-Konten als JSON-Liste. Erzeugt mit:
#   npm run crm:benutzer -- --name crm_admin --rolle admin
# Die Passwörter stehen darin als scrypt-Hash, nie im Klartext.
CRM_BENUTZER=

# Schlüssel, mit dem die CRM-Sitzungscookies signiert werden. Mindestens 32
# Zeichen; das Skript oben schlägt einen vor. Wird er gewechselt, sind alle
# offenen Sitzungen sofort ungültig.
CRM_SESSION_SECRET=

# Verbindung zur Postgres-Datenbank, in der die Anträge liegen. Wird beim
# Anlegen der Datenbank über Vercel (Storage → Neon) automatisch eingetragen.
# Ist sie leer, weicht das CRM auf eine Liste im Arbeitsspeicher aus — gut zum
# Arbeiten an der Seite, aber Einträge verschwinden wieder.
# Alternativ erkannt: POSTGRES_URL, DATABASE_URL_UNPOOLED,
# POSTGRES_URL_NON_POOLING.
DATABASE_URL=

# Basisadresse der Seite, für kanonische Adressen und die Sitemap.
NEXT_PUBLIC_SITE_URL=

# Schaltet den Entwicklermodus der Antragsstrecke auch auf der
# veröffentlichten Seite frei ("1"). Leer lassen — sonst lassen sich Schritte
# ohne Eingaben überspringen und halbe Fälle landen im CRM.
NEXT_PUBLIC_DEV_MODUS=
